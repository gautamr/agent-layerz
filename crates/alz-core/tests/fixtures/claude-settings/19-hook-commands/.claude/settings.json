{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.harness/scripts/notify.sh",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.harness/scripts/guard.sh",
            "onFailure": "block",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ]
  }
}
